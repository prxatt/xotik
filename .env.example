# Copy `.env.example` to `.env.local` for local overrides.
# Never commit secrets.

# Public site URL (used for OG tags in later phases)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (public cloud name — delivery URLs only)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dj0n7b4ma

# Analytics (optional — enable only after cookie consent in production)
# NEXT_PUBLIC_ANALYTICS_ID=
